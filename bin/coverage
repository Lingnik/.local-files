#!/usr/bin/env python3
"""
Simplecov JSON coverage analyzer.
Prints uncovered lines in format: <filename> @ <line#>: <code>
"""

import json
import sys
import os
import argparse
from pathlib import Path


def find_coverage_file(worktree_root):
    """Find the coverage.json file in the worktree."""
    possible_paths = [
        "coverage/coverage.json",
        "coverage.json"
    ]
    
    for path in possible_paths:
        full_path = os.path.join(worktree_root, path)
        if os.path.exists(full_path):
            return full_path
    
    return None


def get_file_content(filepath):
    """Read file content and return lines."""
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            return f.readlines()
    except (FileNotFoundError, UnicodeDecodeError):
        return None


def analyze_coverage(coverage_file):
    """Analyze coverage JSON and return uncovered lines."""
    try:
        with open(coverage_file, 'r') as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"Error reading coverage file: {e}", file=sys.stderr)
        return
    
    coverage_data = data.get('coverage', {})
    uncovered_lines = []
    
    for filepath, file_data in coverage_data.items():
        lines_coverage = file_data.get('lines', [])
        
        # Get the actual file content
        file_content = get_file_content(filepath)
        if file_content is None:
            continue
        
        # Find uncovered lines (coverage value is 0)
        for line_num, coverage_count in enumerate(lines_coverage, 1):
            if coverage_count == 0:  # Line was not executed
                if line_num <= len(file_content):
                    line_content = file_content[line_num - 1].rstrip('\n\r')
                    # Get relative path for cleaner output
                    rel_path = os.path.relpath(filepath)
                    uncovered_lines.append((rel_path, line_num, line_content))
    
    return uncovered_lines


def main():
    parser = argparse.ArgumentParser(
        description="Analyze simplecov JSON coverage and show uncovered lines"
    )
    parser.add_argument(
        'coverage_file',
        nargs='?',
        help='Path to coverage.json file (default: auto-detect in current directory)'
    )
    
    args = parser.parse_args()
    
    # Determine coverage file path
    if args.coverage_file:
        coverage_file = args.coverage_file
    else:
        # Auto-detect in current directory
        worktree_root = os.getcwd()
        coverage_file = find_coverage_file(worktree_root)
        if not coverage_file:
            print("Error: No coverage.json file found. Looked in:", file=sys.stderr)
            print("  - coverage/coverage.json", file=sys.stderr)
            print("  - coverage.json", file=sys.stderr)
            print("Use: coverage <path-to-coverage.json>", file=sys.stderr)
            sys.exit(1)
    
    # Analyze coverage
    uncovered_lines = analyze_coverage(coverage_file)
    
    if not uncovered_lines:
        print("All lines are covered! 🎉")
        return
    
    # Print uncovered lines
    print(f"Found {len(uncovered_lines)} uncovered lines:")
    print()
    
    for filepath, line_num, line_content in uncovered_lines:
        print(f"{filepath} @ {line_num}: {line_content}")


if __name__ == "__main__":
    main()
