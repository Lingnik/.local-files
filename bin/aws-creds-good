#!/bin/bash
# AWS Credentials Validation Script
# Checks if AWS credentials in environment variables are valid

set -e

# Parse command line arguments
SILENT=false
while [[ $# -gt 0 ]]; do
    case $1 in
        -s|--silent)
            SILENT=true
            shift
            ;;
        -h|--help)
            if [[ "$SILENT" != "true" ]]; then
                echo "Usage: $0 [-s|--silent] [-h|--help]"
                echo "  -s, --silent    Suppress all output, only return exit code"
                echo "  -h, --help      Show this help message"
            fi
            exit 0
            ;;
        *)
            if [[ "$SILENT" != "true" ]]; then
                echo "Unknown option: $1"
                echo "Use -h or --help for usage information"
            fi
            exit 1
            ;;
    esac
done

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    if [[ "$SILENT" == "true" ]]; then
        return
    fi
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to check AWS credentials using AWS CLI
check_with_aws_cli() {
    print_status $BLUE "🔍 Checking credentials with AWS CLI..."
    
    if ! command_exists aws; then
        print_status $RED "❌ AWS CLI not found. Please install it first."
        return 1
    fi
    
    # Test with STS GetCallerIdentity (lightweight call)
    if aws sts get-caller-identity --output json >/dev/null 2>&1; then
        local identity=$(aws sts get-caller-identity --output json 2>/dev/null)
        
        # Parse JSON using jq if available, otherwise use grep/sed
        if command_exists jq; then
            local account=$(echo "$identity" | jq -r '.Account // empty')
            local user_id=$(echo "$identity" | jq -r '.UserId // empty')
            local arn=$(echo "$identity" | jq -r '.Arn // empty')
        else
            local account=$(echo "$identity" | grep -o '"Account":"[^"]*"' | cut -d'"' -f4)
            local user_id=$(echo "$identity" | grep -o '"UserId":"[^"]*"' | cut -d'"' -f4)
            local arn=$(echo "$identity" | grep -o '"Arn":"[^"]*"' | cut -d'"' -f4)
        fi
        
        print_status $GREEN "✅ AWS credentials are valid!"
        if [[ -n "$account" ]]; then
            print_status $GREEN "   Account: $account"
        fi
        if [[ -n "$user_id" ]]; then
            print_status $GREEN "   User ID: $user_id"
        fi
        if [[ -n "$arn" ]]; then
            print_status $GREEN "   ARN: $arn"
        fi
        
        # If no details were parsed, show the raw JSON for debugging
        if [[ -z "$account" && -z "$user_id" && -z "$arn" ]]; then
            print_status $YELLOW "   Raw response: $identity"
        fi
        
        return 0
    else
        print_status $RED "❌ AWS credentials are invalid or expired"
        return 1
    fi
}

# Function to check AWS credentials using curl (no AWS CLI required)
check_with_curl() {
    print_status $BLUE "🔍 Checking credentials with curl..."
    
    if ! command_exists curl; then
        print_status $RED "❌ curl not found. Please install it first."
        return 1
    fi
    
    # Check if required environment variables are set
    if [[ -z "$AWS_ACCESS_KEY_ID" || -z "$AWS_SECRET_ACCESS_KEY" ]]; then
        print_status $RED "❌ AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY not set"
        return 1
    fi
    
    # Create a simple AWS signature for STS GetCallerIdentity
    local region="${AWS_REGION:-us-east-1}"
    local service="sts"
    local host="sts.${region}.amazonaws.com"
    local endpoint="https://${host}"
    local method="POST"
    local uri="/"
    local query=""
    local payload="Action=GetCallerIdentity&Version=2011-06-15"
    local content_type="application/x-www-form-urlencoded; charset=utf-8"
    
    # Get current timestamp
    local timestamp=$(date -u +"%Y%m%dT%H%M%SZ")
    local date_stamp=$(date -u +"%Y%m%d")
    
    # Create canonical request
    local canonical_request="${method}\n${uri}\n${query}\nhost:${host}\ncontent-type:${content_type}\nx-amz-date:${timestamp}\n\nhost;x-amz-date\n$(echo -n "$payload" | sha256sum | cut -d' ' -f1)"
    
    # Create string to sign
    local credential_scope="${date_stamp}/${region}/${service}/aws4_request"
    local string_to_sign="AWS4-HMAC-SHA256\n${timestamp}\n${credential_scope}\n$(echo -n "$canonical_request" | sha256sum | cut -d' ' -f1)"
    
    # Create signing key
    local k_date=$(echo -n "$date_stamp" | openssl dgst -sha256 -hmac "AWS4$AWS_SECRET_ACCESS_KEY" -binary)
    local k_region=$(echo -n "$region" | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$(echo -n "$k_date" | xxd -p -c 256)" -binary)
    local k_service=$(echo -n "$service" | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$(echo -n "$k_region" | xxd -p -c 256)" -binary)
    local k_signing=$(echo -n "aws4_request" | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$(echo -n "$k_service" | xxd -p -c 256)" -binary)
    
    # Create signature
    local signature=$(echo -n "$string_to_sign" | openssl dgst -sha256 -mac HMAC -macopt "hexkey:$(echo -n "$k_signing" | xxd -p -c 256)" -binary | xxd -p -c 256)
    
    # Create authorization header
    local authorization="AWS4-HMAC-SHA256 Credential=${AWS_ACCESS_KEY_ID}/${credential_scope}, SignedHeaders=host;x-amz-date, Signature=${signature}"
    
    # Make the request
    local response=$(curl -s -w "\n%{http_code}" \
        -X POST \
        -H "Host: $host" \
        -H "Content-Type: $content_type" \
        -H "X-Amz-Date: $timestamp" \
        -H "Authorization: $authorization" \
        -d "$payload" \
        "$endpoint")
    
    local http_code=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | sed '$d')
    
    if [[ "$http_code" == "200" ]]; then
        print_status $GREEN "✅ AWS credentials are valid!"
        # Parse and display account info
        local account=$(echo "$body" | grep -o '<Account>[^<]*</Account>' | sed 's/<[^>]*>//g')
        local user_id=$(echo "$body" | grep -o '<UserId>[^<]*</UserId>' | sed 's/<[^>]*>//g')
        local arn=$(echo "$body" | grep -o '<Arn>[^<]*</Arn>' | sed 's/<[^>]*>//g')
        
        if [[ -n "$account" ]]; then
            print_status $GREEN "   Account: $account"
        fi
        if [[ -n "$user_id" ]]; then
            print_status $GREEN "   User ID: $user_id"
        fi
        if [[ -n "$arn" ]]; then
            print_status $GREEN "   ARN: $arn"
        fi
        return 0
    else
        print_status $RED "❌ AWS credentials are invalid or expired"
        print_status $RED "   HTTP Status: $http_code"
        print_status $RED "   Response: $body"
        return 1
    fi
}

# Function to check environment variables
check_env_vars() {
    print_status $BLUE "🔍 Checking environment variables..."
    
    local missing_vars=()
    
    if [[ -z "$AWS_ACCESS_KEY_ID" ]]; then
        missing_vars+=("AWS_ACCESS_KEY_ID")
    fi
    
    if [[ -z "$AWS_SECRET_ACCESS_KEY" ]]; then
        missing_vars+=("AWS_SECRET_ACCESS_KEY")
    fi
    
    if [[ -z "$AWS_SESSION_TOKEN" ]]; then
        print_status $YELLOW "⚠️  AWS_SESSION_TOKEN not set (optional for some credential types)"
    fi
    
    if [[ ${#missing_vars[@]} -gt 0 ]]; then
        print_status $RED "❌ Missing required environment variables:"
        for var in "${missing_vars[@]}"; do
            print_status $RED "   - $var"
        done
        return 1
    fi
    
    print_status $GREEN "✅ All required environment variables are set"
    print_status $GREEN "   AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:0:10}..."
    print_status $GREEN "   AWS_SECRET_ACCESS_KEY: set (${#AWS_SECRET_ACCESS_KEY} chars)"
    if [[ -n "$AWS_SESSION_TOKEN" ]]; then
        print_status $GREEN "   AWS_SESSION_TOKEN: set (${#AWS_SESSION_TOKEN} chars)"
    fi
    print_status $GREEN "   AWS_REGION: ${AWS_REGION:-us-east-1 (default)}"
    
    return 0
}

# Main function
main() {
    print_status $BLUE "🚀 AWS Credentials Validation"
    print_status $BLUE "=============================="
    if [[ "$SILENT" != "true" ]]; then
        echo
    fi
    
    # Check environment variables first
    if ! check_env_vars; then
        exit 1
    fi
    
    if [[ "$SILENT" != "true" ]]; then
        echo
    fi
    
    # Try AWS CLI first (simpler and more reliable)
    if command_exists aws; then
        if check_with_aws_cli; then
            exit 0
        else
            print_status $YELLOW "⚠️  AWS CLI check failed, trying curl method..."
            if [[ "$SILENT" != "true" ]]; then
                echo
            fi
        fi
    else
        print_status $YELLOW "⚠️  AWS CLI not found, trying curl method..."
        if [[ "$SILENT" != "true" ]]; then
            echo
        fi
    fi
    
    # Fallback to curl method
    if check_with_curl; then
        exit 0
    else
        exit 1
    fi
}

# Run main function
main "$@"
